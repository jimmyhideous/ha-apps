{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],

  "enabledManagers": ["custom.regex", "dockerfile", "github-actions"],

  "semanticCommits": "disabled",
  "labels": ["dependencies"],

  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],

  "customManagers": [
    {
      "customType": "regex",
      "description": "ha_alloy: Grafana Alloy release (ARG ALLOY_VERSION)",
      "managerFilePatterns": ["/^ha_alloy/Dockerfile$/"],
      "matchStrings": ["ARG ALLOY_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "grafana/alloy",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "ha_alloy smoke test images",
      "managerFilePatterns": ["/^ha_alloy/tests/smoke\\.sh$/"],
      "matchStrings": ["_IMAGE=\"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "description": "GitHub Actions: weekly",
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "schedule": ["before 8am on monday"]
    },
    {
      "description": "Ignore runner labels and action version inputs",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner", "uses-with"],
      "enabled": false
    },
    {
      "description": "Home Assistant actions on a branch (dev/main/master): not pinned",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["home-assistant/**"],
      "matchCurrentValue": "/^(dev|main|master)$/",
      "pinDigests": false
    },
    {
      "description": "Grafana Alloy: releases older than 3 days",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["grafana/alloy"],
      "addLabels": ["alloy"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Grafana Alloy: automerge minor and patch",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["grafana/alloy"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "Smoke test images: automerge minor and patch",
      "matchFileNames": ["ha_alloy/tests/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "App updates: note about the version bump commit",
      "matchFileNames": ["ha_alloy/**", "!ha_alloy/tests/**"],
      "prBodyNotes": [
        "`Renovate version bump` adds the `version` bump and `CHANGELOG.md` entry to this pull request. Merging publishes the new image tag."
      ]
    }
  ]
}
